# backend/.env.example
# Application settings
APP_NAME="FIATTIB Healthcare API"
ADMIN_EMAIL="admin@fiattib.com"
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL="postgresql://fiattib:fiattib_pass@localhost:5432/fiattib_db"

# FHIR Server
FHIR_BASE_URL="http://localhost:8080/fhir"

# SNOMED CT Server
SNOMED_SERVER_URL="https://snowstorm.ihtsdotools.org"
SNOMED_EDITION="SNOMEDCT-US"

# LOINC Server
LOINC_SERVER_URL="https://fhir.loinc.org"

# Email Service
EMAIL_API_URL="http://localhost:8001/api"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# SMS Service
SMS_API_URL="http://localhost:8002/api"

# Redis
REDIS_URL="redis://localhost:6379"

# Frontend URLs
FRONTEND_URL="http://localhost:3000"
ADMIN_FRONTEND_URL="http://localhost:3001"