# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
app.log
uvicorn_*.log

# Database files
*.db
ehr.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.local
.env.*.local

# Uploads (should be in Cloud Storage in production)
uploads/
backups/

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker
docker-compose.yml
Dockerfile.dev

# Documentation
*.md
!README.md

# Large directories that shouldn't be deployed
# PACS directory (contains frontend code - 3000+ files!)
app/common/pacs/

# Database migrations and scripts (not needed in container)
database/
*.sql

# Node modules (if any)
node_modules/

# Root-level utility scripts (not needed in production)
*.py
!app/**/*.py
!run.py

# Scripts directory (utility scripts, not needed in production)
scripts/
!app/scripts/**/*.py

# Temporary files
*.tmp
*.bak
*.swp

# Large media files (exclude from PACS)
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.webp

# TypeScript/JavaScript files (frontend code in backend directory)
*.ts
*.tsx
*.js
*.jsx
*.json
!package.json
!package-lock.json
!requirements.txt
!openapi.json
!cloudbuild.yaml
!Dockerfile

# Other large files
*.zip
*.tar
*.tar.gz
*.rar

# Frontend files that shouldn't be in backend
LabReport.jsx
