# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
app.log
uvicorn_*.log

# Database files
*.db
ehr.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.local
.env.*.local

# Uploads (should be in Cloud Storage in production)
uploads/
backups/

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker
docker-compose.yml
Dockerfile.dev

# Documentation
*.md
!README.md

# Scripts (keep only necessary ones)
scripts/
*.py
!app/**/*.py

# Temporary files
*.tmp
*.bak
*.swp

